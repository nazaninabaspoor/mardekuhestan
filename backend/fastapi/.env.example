SUPPORT_INTERNAL_TOKEN=change-me-support-internal

CELERY_BROKER_URL=amqp://mardekoohestan:change-me@127.0.0.1:5672//
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

DJANGO_BASE_URL=http://127.0.0.1:8000
DJANGO_ADMIN_SUPPORT_URL=http://127.0.0.1:8000/admin/support/supportconversation/

# WhatsApp admin ping: log | meta | greenapi
WHATSAPP_PROVIDER=log
WHATSAPP_ADMIN_PHONE=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GREENAPI_INSTANCE_ID=
WHATSAPP_GREENAPI_TOKEN=

KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
OPENSEARCH_HOST=127.0.0.1
OPENSEARCH_PORT=9200
QDRANT_URL=http://127.0.0.1:6333

MINIO_ENDPOINT_URL=http://127.0.0.1:9010
MINIO_ROOT_USER=mardekoohestan
