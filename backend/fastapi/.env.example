APP_NAME=MardeKuhestan AI Service
ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Must equal Django SECRET_KEY
JWT_SECRET=change-me
JWT_ALGORITHM=HS256

DATABASE_URL=postgresql+asyncpg://mardekoohestan:change-me@127.0.0.1:55432/mardekoohestan_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

REDIS_URL=redis://127.0.0.1:6379/0
