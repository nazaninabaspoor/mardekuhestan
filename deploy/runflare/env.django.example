# =============================================================================
# Runflare — env سرویس Django (دامنه: koohestanesepid.com)
# =============================================================================

DEBUG=False
SECRET_KEY=
JWT_SECRET=

ALLOWED_HOSTS=koohestanesepid.com,www.koohestanesepid.com,.runflare.cloud
CORS_ALLOWED_ORIGINS=https://koohestanesepid.com,https://www.koohestanesepid.com
CSRF_TRUSTED_ORIGINS=https://koohestanesepid.com,https://www.koohestanesepid.com

FRONTEND_URL=https://koohestanesepid.com
BACKEND_PUBLIC_URL=https://koohestanesepid.com
FASTAPI_BASE_URL=https://koohestanesepid.com
DJANGO_BASE_URL=https://koohestanesepid.com
CORS_ORIGINS=https://koohestanesepid.com,https://www.koohestanesepid.com

AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_DOMAIN=.koohestanesepid.com
TRUST_X_FORWARDED_FOR=true
SECURE_SSL_REDIRECT=false

RUNFLARE_PUBLIC_DISK=true
PUBLIC_DIR=/app/public
SERVE_FRONTEND_FROM_DJANGO=true

# حیاتی — پکیج استاندارد (نه root wsgi.py)
DJANGO_SETTINGS_MODULE=core.settings
DJANGO_WSGI_MODULE=koohestan.asgi
WSGI_MODULE=koohestan.asgi
DJANGO_ASGI_MODULE=koohestan.asgi
APP_MODULE=koohestan.asgi

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432

REDIS_URL=
CHANNEL_REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

ZARINPAL_SANDBOX=true
ZARINPAL_MERCHANT_ID=
SUPPORT_INTERNAL_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
