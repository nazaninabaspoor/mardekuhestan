# =============================================================================
# Runflare — متغیرهای محیطی سرویس Django واحد
# (Django + FastAPI روی /api/v1 + فرانت استاتیک از public/web)
# مقادیر خالی را در پنل پر کنید. این فایل را commit نکنید با Secret واقعی.
# =============================================================================

DEBUG=False
SECRET_KEY=
ALLOWED_HOSTS=mardekuhestan.com,www.mardekuhestan.com
CORS_ALLOWED_ORIGINS=https://mardekuhestan.com,https://www.mardekuhestan.com
CSRF_TRUSTED_ORIGINS=https://mardekuhestan.com,https://www.mardekuhestan.com

FRONTEND_URL=https://mardekuhestan.com
BACKEND_PUBLIC_URL=https://mardekuhestan.com
FASTAPI_BASE_URL=https://mardekuhestan.com

AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_DOMAIN=.mardekuhestan.com
TRUST_X_FORWARDED_FOR=true
SECURE_SSL_REDIRECT=true

RUNFLARE_PUBLIC_DISK=true
PUBLIC_DIR=/app/public
SERVE_FRONTEND_FROM_DJANGO=true

# Postgres — از سرویس دیتابیس Runflare کپی کنید
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432

# Redis — اگر سرویس Redis ساختید
REDIS_URL=
CHANNEL_REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# پرداخت
ZARINPAL_SANDBOX=true
ZARINPAL_MERCHANT_ID=
SUPPORT_INTERNAL_TOKEN=

# ایمیل
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
ORDER_NOTIFY_EMAILS=

# FastAPI / AI
JWT_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DJANGO_BASE_URL=https://mardekuhestan.com
CORS_ORIGINS=https://mardekuhestan.com,https://www.mardekuhestan.com
DATABASE_URL=

# فرانت (زمان بیلد لوکال قبل از دیپلوی)
# NEXT_PUBLIC_SITE_URL=https://mardekuhestan.com
# NEXT_PUBLIC_API_BASE_URL=https://mardekuhestan.com
# NEXT_PUBLIC_FASTAPI_BASE_URL=https://mardekuhestan.com
# NEXT_PUBLIC_SALES_CHANNEL=b2c
# NEXT_PUBLIC_ENAMAD_ID=
# NEXT_PUBLIC_ENAMAD_CODE=
